rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['subscriptionStatus', 'stripeCustomerId', 'payoutOwed', 'referralCode', 'xp', 'streakCount']
        );
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Home feed + Me tab posts: photos, user videos, and shared links
    match /posts/{postId} {
      // Private posts are only readable by their owner or an admin — everything else stays public.
      // "resource == null ||" first: a get() on a post ID that doesn't exist (deleted, or a
      // typo'd link) must resolve to "not found", not a permission error — without this guard,
      // referencing resource.data on a null resource fails the whole rule instead.
      allow read: if resource == null
        || resource.data.visibility != 'private'
        || (request.auth != null && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.token.email in ['mehta.siddharth09@gmail.com']
        ));

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['photo', 'video', 'link', 'text'];

      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
      );

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    // Subjects (Music, Art, etc.) — admin-managed, read-only for everyone else
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false; // manage from the Firebase console for now
    }

    // Pre-recorded lesson videos — admin-managed, read-only for everyone else
    match /lessons/{lessonId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) ||
        request.auth.token.email in ['mehta.siddharth09@gmail.com']
      );
      allow create, delete: if request.auth != null
        && request.auth.token.email in ['mehta.siddharth09@gmail.com'];
    }

    // Trailer/preview videos shown on the home feed and subscribe prompt — admin-managed
    match /trailers/{trailerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email in ['mehta.siddharth09@gmail.com'];
    }

    // Tracks which lessons a user has completed
    match /lessonProgress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Follow graph
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Saved / bookmarked posts — private to the saver
    // "resource == null ||" lets the app check "have I saved this?" for a post it's never
    // saved before (the common case) and get a clean exists:false instead of a permission error.
    match /saves/{saveId} {
      allow read: if resource == null || (request.auth != null && request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Direct messages — only the two participants can read/write
    // "resource == null ||" lets the app check "does this conversation exist yet?" before
    // creating the first one between two people and get exists:false instead of an error.
    match /conversations/{conversationId} {
      allow read: if resource == null || (request.auth != null && request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Abuse reports — reporters shouldn't be able to read each other's reports, and admins
    // need to list "all pending reports", which client-side rules can't safely filter. All
    // access goes through the submitReport/getReports/resolveReport Cloud Functions instead
    // (Admin SDK bypasses these rules), so client access is denied entirely.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Monthly creative-prize winners (name/likes/paid status) and members' payout details
    // (bank/PayID) — same reasoning as `reports`: the leaderboard and winner banner are served
    // through the getPrizeLeaderboard/getLatestPrizeWinner callables (public fields only), the
    // admin dashboard through getPrizeWinners/markPrizeWinnerPaid, and payout details are only
    // ever written by their owner via the submitPrizePayoutDetails callable — never by a
    // direct client read/write, since prizePayouts holds sensitive bank/PayID info.
    match /prizeWinners/{month} {
      allow read, write: if false;
    }

    match /prizePayouts/{postId} {
      allow read, write: if false;
    }
  }
}
