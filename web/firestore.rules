rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if either user has blocked the other (blockUser/unblockUser in functions/index.js
    // keep blockedUserIds/blockedByUserIds in sync on both docs, so checking blockedUserIds
    // from both sides is enough — no need to also check blockedByUserIds here). get()/exists()
    // run with rules-evaluation access regardless of the target doc's own read rules, so this
    // works even though users/{userId} is owner-read-only below.
    function isBlockedPair(uidA, uidB) {
      return (exists(/databases/$(database)/documents/users/$(uidA))
                && uidB in get(/databases/$(database)/documents/users/$(uidA)).data.get('blockedUserIds', []))
          || (exists(/databases/$(database)/documents/users/$(uidB))
                && uidA in get(/databases/$(database)/documents/users/$(uidB)).data.get('blockedUserIds', []));
    }

    match /users/{userId} {
      // Was `if request.auth != null` — any signed-in account, not just this doc's owner, could
      // read the WHOLE document, including stripeCustomerId, payoutOwed, and subscriptionStatus.
      // Rules can only gate access to a whole document, never individual fields on it, so the
      // only way to keep those fields owner-only while still letting everyone else see a name
      // and a photo is to serve that public slice through a Cloud Function instead — see
      // getPublicProfile/listPublicProfiles in functions/index.js, same pattern already used
      // below for prizeWinners/payoutAccounts/refundRequests.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allowlist, not a blocklist: the client only ever legitimately sets these four fields
      // (see AuthContext.tsx, usePushNotifications.ts). Everything else — subscriptionStatus,
      // stripeCustomerId, payoutOwed, referralCode, xp, streakCount, canceledAt,
      // freePreviewSecondsUsed, blockedUserIds, blockedByUserIds, and any field added later — is
      // server-only via the Admin SDK (blockUser/unblockUser in functions/index.js), so a client
      // can't just add themselves to someone's blockedByUserIds to silently hide their own posts
      // from that person, or clear their own blockedUserIds to un-hide someone without going
      // through the real unblock flow.
      // The previous version only blocked those specific names, which meant a client could
      // create their own users/{uid} doc directly (e.g. from the browser console, bypassing the
      // app entirely) with subscriptionStatus: "active" set from the very first write — free,
      // unlimited access to every paid lesson with zero Stripe charge. This closes that off.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'countryCode', 'pushToken']);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['displayName', 'photoURL', 'countryCode', 'pushToken']
        );
    }

    match /profiles/{userId} {
      allow read: if true;
      // Allowlist, not a blanket allow — the client only ever legitimately sets these two
      // fields (see signup/login). Same reasoning as the users/{userId} allowlist above:
      // without this, anyone could write arbitrary fields onto their own publicly-readable
      // profiles doc.
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt']);
    }

    // Home feed + Me tab posts: photos, user videos, and shared links
    match /posts/{postId} {
      // Private posts are only readable by their owner or an admin — everything else stays public.
      // "resource == null ||" first: a get() on a post ID that doesn't exist (deleted, or a
      // typo'd link) must resolve to "not found", not a permission error — without this guard,
      // referencing resource.data on a null resource fails the whole rule instead.
      // Posts auto-flagged by moderatePostMedia (functions/index.js) get the same owner/admin-only
      // treatment as private ones — this is what actually keeps a flagged post hidden from a direct
      // /post/[id] page load, since that page reads the doc straight from the client rather than
      // through getFeed's isVisibleTo check.
      allow read: if resource == null
        || (resource.data.visibility != 'private' && resource.data.moderationStatus != 'flagged')
        || (request.auth != null && (
          request.auth.uid == resource.data.ownerId ||
          (request.auth.token.email in ['mehta.siddharth09@gmail.com'] && request.auth.token.email_verified == true)
        ));

      // likeCount/commentCount must start at 0 (or be omitted) — without this, the *update*
      // rule's protection below is moot, since anyone could just create a brand-new post with
      // likeCount already set to whatever they want and instantly top the real-money Creative
      // Prize leaderboard with zero genuine likes.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['photo', 'video', 'link', 'text']
        && (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0)
        && (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0);

      // Was also carve-out-able by ANY signed-in user via hasOnly(['likeCount']) /
      // hasOnly(['commentCount']) — that let anyone set a post's likeCount/commentCount to
      // whatever they wanted, directly forging the real-money Creative Prize leaderboard.
      // Those counts are now maintained server-side only (onLikeCreated/onLikeDeleted/
      // onCommentCreated/onCommentDeleted in functions/index.js, via the Admin SDK, which
      // isn't subject to these rules) — a client update can only ever be the post's own owner
      // editing their own post, and ownerId itself can never change on an update.
      // Ownership alone isn't enough here: without also excluding likeCount/commentCount, a
      // post's OWNER could still set their own post's counts to whatever they want — which is
      // exactly the same real-money Creative Prize leaderboard forgery the comment above already
      // worried about, just from the owner's own account instead of a stranger's.
      // moderationStatus/moderationFlags are excluded the same way — without this, a post's own
      // owner could simply clear their own auto-flagged content back to visible by editing the
      // post from the client, which would defeat the whole point of moderatePostMedia. Only that
      // trigger (Admin SDK) sets or clears these fields.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['likeCount', 'commentCount', 'moderationStatus', 'moderationFlags']);

      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // The doc ID being the liker's own uid means Firestore itself makes a second like from
      // the same account structurally impossible — creating over an existing doc ID is an
      // update, not a create, and there's no update rule here, so it's denied outright.
      match /likes/{userId} {
        allow read: if true;
        // Can't like your own post — without this, liking your own post from your own account
        // inflates your own real-money Creative Prize likeCount for free. (This can't stop
        // someone liking their own post from a *different* account they also control — that's
        // an identity problem no rule can see through — but it closes the free, one-click
        // version of it.)
        allow create: if request.auth != null && request.auth.uid == userId
          && userId != get(/databases/$(database)/documents/posts/$(postId)).data.ownerId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }
    }

    // Subjects (Music, Art, etc.) — admin-managed, read-only for everyone else
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false; // manage from the Firebase console for now
    }

    // Pre-recorded lesson videos — admin-managed, read-only for everyone else. The public doc
    // holds only browsable metadata (title, subjectId, viewCount, etc.) — the actual Bunny
    // playback credentials live in the gated lessonPlayback doc below instead, moved there
    // automatically by migrateLessonPlaybackFields in functions/index.js. Without that split,
    // anyone could read bunnyVideoId/bunnyLibraryId straight off this doc (Firestore rules can
    // only gate a whole document, never individual fields on it) and load the unauthenticated
    // Bunny embed URL directly, completely bypassing the subscription paywall.
    match /lessons/{lessonId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) ||
        (request.auth.token.email in ['mehta.siddharth09@gmail.com'] && request.auth.token.email_verified == true)
      );
      allow create, delete: if request.auth != null
        && (request.auth.token.email in ['mehta.siddharth09@gmail.com'] && request.auth.token.email_verified == true);
    }

    // Lesson playback credentials (bunnyVideoId/bunnyLibraryId) — never readable directly by a
    // client. Handed out only by the getLessonPlayback Cloud Function, which checks the
    // caller's subscription status first. Written only by migrateLessonPlaybackFields /
    // backfillLessonPlayback (Admin SDK, bypasses these rules).
    match /lessonPlayback/{lessonId} {
      allow read, write: if false;
    }

    // Trailer/preview videos shown on the home feed and subscribe prompt — admin-managed
    match /trailers/{trailerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && (request.auth.token.email in ['mehta.siddharth09@gmail.com'] && request.auth.token.email_verified == true);
    }

    // Tracks which lessons a user has completed
    match /lessonProgress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // Was create-able directly by the client (only checking uid ownership) — that let anyone
      // fabricate "completed" lessons they never watched, including enough fake completions to
      // trigger completeLesson's own "mastered a subject" XP bonus for real. No client code
      // actually writes here directly (grep confirms it); completeLesson (Admin SDK, bypasses
      // this rule) is the only legitimate writer, so this can just be denied outright.
      allow write: if false;
    }

    // Follow graph
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Saved / bookmarked posts — private to the saver
    // "resource == null ||" lets the app check "have I saved this?" for a post it's never
    // saved before (the common case) and get a clean exists:false instead of a permission error.
    match /saves/{saveId} {
      allow read: if resource == null || (request.auth != null && request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Direct messages — only the two participants can read/write
    // "resource == null ||" lets the app check "does this conversation exist yet?" before
    // creating the first one between two people and get exists:false instead of an error.
    match /conversations/{conversationId} {
      allow read: if resource == null || (request.auth != null && request.auth.uid in resource.data.participants);
      // Blocking (either direction) stops a brand-new conversation from ever being created —
      // participants is always exactly [uidA, uidB].sort() (see app/messages/page.tsx), so
      // indexing both elements is safe.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants
        && !isBlockedPair(request.resource.data.participants[0], request.resource.data.participants[1]);
      // Pin the participant list — without this, any existing participant could silently add a
      // third party to a private DM thread (which can include real bank/PayID details shared
      // for prize payouts) just by updating lastMessage/lastMessageAt alongside a changed
      // participants array.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        // Also stops a NEW message in an ALREADY-existing conversation the moment either side
        // blocks the other — not just at conversation-creation time.
        allow create: if request.auth != null
          && !isBlockedPair(
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
               get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
             )
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Abuse reports — reporters shouldn't be able to read each other's reports, and admins
    // need to list "all pending reports", which client-side rules can't safely filter. All
    // access goes through the submitReport/getReports/resolveReport Cloud Functions instead
    // (Admin SDK bypasses these rules), so client access is denied entirely.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Client-side crash/error reports — same reasoning as `reports`: written only via the
    // logClientError callable (which deliberately allows unauthenticated calls, since a crash on
    // the login screen matters too), read only via getClientErrors/resolveClientError, both
    // admin-gated. No legitimate client read/write path exists directly against this collection.
    match /clientErrors/{errorId} {
      allow read, write: if false;
    }

    // Monthly creative-prize winners (name/likes/paid status) and members' payout details
    // (bank/PayID) — same reasoning as `reports`: the leaderboard and winner banner are served
    // through the getPrizeLeaderboard/getLatestPrizeWinner callables (public fields only), the
    // admin dashboard through getPrizeWinners/markPrizeWinnerPaid, and payout details are only
    // ever written by their owner via the submitPrizePayoutDetails callable — never by a
    // direct client read/write, since prizePayouts holds sensitive bank/PayID info.
    match /prizeWinners/{month} {
      allow read, write: if false;
    }

    match /prizePayouts/{postId} {
      allow read, write: if false;
    }

    // Stripe Connect account IDs + payout-readiness for the automated prize-payout rail. Only
    // ever written by createPayoutOnboardingLink / the stripeWebhook's account.updated handler
    // (Admin SDK, bypasses these rules), and only ever read by getPayoutAccountStatus /
    // getPrizeWinners / payWinnerViaStripe — never directly by a client, same reasoning as
    // prizePayouts above.
    match /payoutAccounts/{uid} {
      allow read, write: if false;
    }

    // Refund requests — same reasoning as prizeWinners/payoutAccounts above: this holds a
    // Stripe customer ID and billing totals, and "who's requested a refund" shouldn't be
    // listable by anyone but an admin. All access goes through the requestRefund/
    // getMyRefundStatus/getRefundRequests/approveRefund Cloud Functions instead (Admin SDK
    // bypasses these rules).
    match /refundRequests/{requestId} {
      allow read, write: if false;
    }

    // Per-account call counters backing enforceRateLimit in functions/index.js (submitReport,
    // requestRefund, fetchLinkPreview, etc). Only ever touched by the Admin SDK inside those
    // functions — a client read would leak nothing sensitive, but a client WRITE would let anyone
    // reset or forge their own counter and bypass the very limits this exists to enforce.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Processed Stripe webhook event ids (stripeWebhook in functions/index.js) — purely an
    // internal dedupe marker so a retried webhook delivery doesn't re-send a confirmation/
    // cancellation email. No legitimate reason for a client to read or write this directly.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
