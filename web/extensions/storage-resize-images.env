# Resizes photo/video-post images uploaded to Storage down to a max 800x800 WebP copy, stored
# alongside the original (never deleted) as "<original-path>_800x800.webp". The app falls back to
# the original mediaUrl if the resized copy doesn't exist yet (e.g. right after upload, before the
# resize function has run, or for posts uploaded before this was turned on).
IMG_BUCKET=astryks-5f31c.firebasestorage.app
IMG_SIZES=800x800
DELETE_ORIGINAL_FILE=false
MAKE_PUBLIC=false
INCLUDE_PATH_LIST=/posts
IMAGE_TYPE=webp
IS_ANIMATED=false
FUNCTION_MEMORY=1024
REGENERATE_TOKEN=true
CONTENT_FILTER_LEVEL=OFF
