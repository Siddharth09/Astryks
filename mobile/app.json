{
  "expo": {
    "name": "Astryks",
    "slug": "astryks",
    "scheme": "astryks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.astryks.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.astryks.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bc1c6e8-1da7-40a4-8222-c3e388aeb9be"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4bc1c6e8-1da7-40a4-8222-c3e388aeb9be"
    }
  }
}
